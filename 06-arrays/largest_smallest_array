#include <stdio.h>
int main(void) {
    int n,a[100],min,max;
    printf("Enter array size (1-100): ");
    if (scanf("%d",&n)!=1 || n<1 || n>100) return 1;
    for (int i=0;i<n;i++) if (scanf("%d",&a[i])!=1) return 1;
    min=max=a[0];
    for (int i=1;i<n;i++) { if(a[i]<min) min=a[i]; if(a[i]>max) max=a[i]; }
    printf("Smallest = %d\nLargest = %d\n",min,max);
    return 0;
}
