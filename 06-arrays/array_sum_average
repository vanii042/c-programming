#include <stdio.h>
int main(void) {
    int n, a[100];
    long long sum=0;
    printf("Enter array size (1-100): ");
    if (scanf("%d", &n) != 1 || n<1 || n>100) return 1;
    printf("Enter %d integers: ", n);
    for (int i=0;i<n;i++) { if (scanf("%d",&a[i])!=1) return 1; sum+=a[i]; }
    printf("Sum = %lld\nAverage = %.2f\n", sum, (double)sum/n);
    return 0;
}
