#include <stdio.h>
int main(void) {
    FILE *fp=fopen("sample.txt","w");
    if(!fp){perror("sample.txt");return 1;}
    fputs("Hello from C file handling!\n",fp);
    fclose(fp);
    fp=fopen("sample.txt","r");
    if(!fp){perror("sample.txt");return 1;}
    char line[200];
    while(fgets(line,sizeof line,fp)) fputs(line,stdout);
    fclose(fp);
    return 0;
}
