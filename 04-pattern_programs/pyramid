#include <stdio.h>
int main(void) {
    int n;
    printf("Enter rows (1-30): ");
    if (scanf("%d", &n) != 1 || n<1 || n>30) return 1;
    for (int i=1;i<=n;i++) {
        for (int s=0;s<n-i;s++) putchar(' ');
        for (int j=0;j<2*i-1;j++) putchar('*');
        putchar('\n');
    }
    return 0;
}
