#include <stdio.h>
int main(void) {
    int n, temp, digits=0;
    long long sum=0;
    printf("Enter a non-negative integer: ");
    if (scanf("%d", &n) != 1 || n < 0) return 1;
    temp=n;
    do { digits++; temp/=10; } while (temp != 0);
    temp=n;
    do {
        int digit=temp%10;
        long long power=1;
        for (int i=0; i<digits; i++) power*=digit;
        sum+=power;
        temp/=10;
    } while (temp != 0);
    puts(sum == n ? "Armstrong number" : "Not an Armstrong number");
    return 0;
}
