#include <stdio.h>
#include <stdlib.h>
int main(void) {
    int *a=calloc(3,sizeof *a);
    if(!a){puts("Allocation failed.");return 1;}
    printf("calloc initializes values: %d %d %d\n",a[0],a[1],a[2]);
    int *temp=realloc(a,5*sizeof *a);
    if(!temp){free(a);puts("Reallocation failed.");return 1;}
    a=temp; a[3]=40; a[4]=50;
    printf("Expanded array: ");
    for(int i=0;i<5;i++) printf("%d ",a[i]);
    putchar('\n');
    free(a);
    return 0;
}
