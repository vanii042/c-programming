#include <stdio.h>
struct Student { char name[50]; int roll; };
int main(void) {
    struct Student s[3];
    for(int i=0;i<3;i++) {
        printf("Enter name and roll for student %d: ",i+1);
        if(scanf("%49s %d",s[i].name,&s[i].roll)!=2) return 1;
    }
    puts("Student records:");
    for(int i=0;i<3;i++) printf("%s - %d\n",s[i].name,s[i].roll);
    return 0;
}
