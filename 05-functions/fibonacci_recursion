#include <stdio.h>
unsigned long long fib(int n) {
    if (n<=1) return (unsigned long long)n;
    return fib(n-1)+fib(n-2);
}
int main(void) {
    int n;
    printf("Enter term index (0 to 40): ");
    if (scanf("%d", &n) != 1 || n<0 || n>40) return 1;
    printf("Fibonacci term = %llu\n", fib(n));
    return 0;
}
