#include <stdio.h>
#include <string.h>
int main(void) {
    char a[200],b[100];
    printf("Enter first line: ");
    if(!fgets(a,sizeof a,stdin)) return 1;
    a[strcspn(a,"\n")]='\0';
    printf("Enter second line: ");
    if(!fgets(b,sizeof b,stdin)) return 1;
    b[strcspn(b,"\n")]='\0';
    if(strlen(a)+strlen(b)+1 > sizeof a) { puts("Combined text is too long."); return 1; }
    strcat(a,b);
    printf("Combined: %s\n",a);
    return 0;
}
